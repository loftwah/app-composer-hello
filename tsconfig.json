{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "noEmitOnError": true,
    "outDir": "dist/typescript"
  },
  "include": ["src/worker.ts", "src/publisher.mts", "worker-configuration.d.ts"]
}
