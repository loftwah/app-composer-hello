{
  "name": "app-composer-hello",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "pnpm source:write && wrangler dev",
    "test": "node --test tests/*.test.mjs",
    "deploy": "node deploy.mjs",
    "source:write": "node scripts/build-source.mjs --write",
    "check:types": "wrangler types --include-runtime=false --strict-vars=false --check && node scripts/build-source.mjs --check",
    "lint": "node scripts/build-source.mjs --lint",
    "format:check": "node scripts/format-source.mjs --check",
    "format": "node scripts/format-source.mjs --write",
    "check": "pnpm check:types && pnpm lint && pnpm format:check && pnpm test",
    "build": "pnpm check:types && wrangler deploy --dry-run --outdir dist"
  },
  "devDependencies": {
    "wrangler": "4.143.1",
    "typescript": "6.0.3",
    "@cloudflare/workers-types": "5.20260929.1",
    "prettier": "3.9.10"
  },
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22 <23"
  }
}
